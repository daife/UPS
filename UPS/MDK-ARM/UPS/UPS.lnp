"ups\stm32f1xx_hal_i2c.o"
"ups\stm32f1xx_hal.o"
"ups\stm32f1xx_hal_rcc.o"
"ups\stm32f1xx_hal_rcc_ex.o"
"ups\stm32f1xx_hal_gpio.o"
"ups\stm32f1xx_hal_dma.o"
"ups\stm32f1xx_hal_cortex.o"
"ups\stm32f1xx_hal_pwr.o"
